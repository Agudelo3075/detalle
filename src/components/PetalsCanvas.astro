---
// PetalsCanvas.astro - Falling flower petals, glowing fireflies & magical particles
---

<canvas id="ambient-canvas" class="ambient-canvas" aria-hidden="true"></canvas>

<style>
  .ambient-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }
</style>

<script>
  function initAmbientCanvas() {
    const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    // Petal class
    interface Petal {
      x: number;
      y: number;
      size: number;
      speedY: number;
      speedX: number;
      angle: number;
      angleSpeed: number;
      flip: number;
      flipSpeed: number;
      color: string;
      opacity: number;
    }

    // Sparkle/firefly class
    interface Sparkle {
      x: number;
      y: number;
      radius: number;
      baseRadius: number;
      speedX: number;
      speedY: number;
      alpha: number;
      pulseSpeed: number;
      hue: number;
    }

    const colors = [
      'rgba(255, 120, 160, ',
      'rgba(255, 80, 125, ',
      'rgba(255, 182, 193, ',
      'rgba(240, 100, 140, ',
      'rgba(255, 200, 220, '
    ];

    const petalCount = window.innerWidth < 768 ? 24 : 45;
    const petals: Petal[] = [];

    for (let i = 0; i < petalCount; i++) {
      petals.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 12 + 10,
        speedY: Math.random() * 1.2 + 0.8,
        speedX: Math.random() * 1.5 - 0.75,
        angle: Math.random() * 360,
        angleSpeed: (Math.random() - 0.5) * 1.5,
        flip: Math.random(),
        flipSpeed: Math.random() * 0.03 + 0.01,
        color: colors[Math.floor(Math.random() * colors.length)],
        opacity: Math.random() * 0.4 + 0.45
      });
    }

    const sparkleCount = window.innerWidth < 768 ? 30 : 60;
    const sparkles: Sparkle[] = [];
    for (let i = 0; i < sparkleCount; i++) {
      sparkles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 1.8 + 0.6,
        baseRadius: Math.random() * 1.8 + 0.6,
        speedX: (Math.random() - 0.5) * 0.35,
        speedY: (Math.random() - 0.5) * 0.35,
        alpha: Math.random() * 0.7 + 0.3,
        pulseSpeed: Math.random() * 0.03 + 0.01,
        hue: Math.random() > 0.4 ? 340 : 45 // Rose or Gold
      });
    }

    // Interactive wind on mouse move
    let mouseWindX = 0;
    window.addEventListener('mousemove', (e) => {
      const delta = (e.clientX - width / 2) / (width / 2);
      mouseWindX = delta * 0.8;
    });

    function drawPetal(ctx: CanvasRenderingContext2D, p: Petal) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate((p.angle * Math.PI) / 180);
      ctx.scale(Math.sin(p.flip), 1);

      ctx.fillStyle = `${p.color}${p.opacity})`;
      ctx.beginPath();
      // Organic rose petal path
      ctx.moveTo(0, 0);
      ctx.bezierCurveTo(-p.size / 2, -p.size / 2, -p.size, p.size / 3, 0, p.size);
      ctx.bezierCurveTo(p.size, p.size / 3, p.size / 2, -p.size / 2, 0, 0);
      ctx.fill();

      // Delicate inner vein
      ctx.strokeStyle = `rgba(255, 255, 255, ${p.opacity * 0.3})`;
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(0, 2);
      ctx.quadraticCurveTo(0, p.size * 0.5, 0, p.size * 0.8);
      ctx.stroke();

      ctx.restore();
    }

    function animate() {
      ctx.clearRect(0, 0, width, height);

      // Draw and update sparkles (fireflies)
      for (const s of sparkles) {
        s.x += s.speedX;
        s.y += s.speedY;
        s.alpha += Math.sin(Date.now() * s.pulseSpeed * 0.01) * 0.02;

        if (s.x < 0) s.x = width;
        if (s.x > width) s.x = 0;
        if (s.y < 0) s.y = height;
        if (s.y > height) s.y = 0;

        const currentAlpha = Math.max(0.15, Math.min(0.9, s.alpha));
        ctx.fillStyle = `hsla(${s.hue}, 90%, 75%, ${currentAlpha})`;
        ctx.shadowColor = `hsla(${s.hue}, 90%, 75%, ${currentAlpha * 0.8})`;
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.shadowBlur = 0;

      // Draw and update petals
      for (const p of petals) {
        p.y += p.speedY;
        p.x += p.speedX + mouseWindX * 0.3;
        p.angle += p.angleSpeed;
        p.flip += p.flipSpeed;

        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        }
        if (p.x > width + 20) {
          p.x = -20;
        } else if (p.x < -20) {
          p.x = width + 20;
        }

        drawPetal(ctx, p);
      }

      requestAnimationFrame(animate);
    }

    animate();
  }

  // Execute on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmbientCanvas);
  } else {
    initAmbientCanvas();
  }
</script>

